<resources>
    <style name="Theme.Cuicatl" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/cuicatl_background</item>
        <item name="android:windowBackground">@color/cuicatl_background</item>
    </style>

    <style name="Theme.Cuicatl.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/cuicatl_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/cuicatl_app_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.Cuicatl</item>
    </style>
</resources>
